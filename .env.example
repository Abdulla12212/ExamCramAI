# Supabase (server-only — never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM adapter. Only "gemini" is implemented in this MVP.
# Future values: gemini | cloudflare | local | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Embeddings. Default uses the Gemini embedding free tier (same API key).
# Must match the pgvector dimension in supabase/schema.sql (768).
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
